{
  "name": "nirman-khata",
  "private": true,
  "scripts": {
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:types": "supabase gen types typescript --local > app/src/lib/database.types.ts",
    "dev": "pnpm --dir app dev",
    "test": "pnpm db:test && pnpm --dir app test",
    "docker:dev": "docker compose -f docker/compose.dev.yaml up --build",
    "docker:prod": "docker compose -f docker/compose.prod.yaml up -d --build"
  },
  "devDependencies": {
    "supabase": "^2.120.0"
  }
}
