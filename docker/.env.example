# Used by compose.prod.yaml. Copy to docker/.env (git-ignored).
# Public values from Supabase dashboard -> Project Settings -> API.
# Never put the service-role / secret key here: it would be shipped to browsers.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
APP_PORT=8080
APP_VERSION=latest
