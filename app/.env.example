VITE_SUPABASE_URL=http://127.0.0.1:55321
VITE_SUPABASE_PUBLISHABLE_KEY=<publishable key from `supabase start` or the project dashboard>
# Show "Forgot password?" (email reset). Turn on only once Supabase Auth has an SMTP sender;
# the built-in mailer delivers only to the project's team. Local mail goes to Mailpit (port 55324).
VITE_EMAIL_RESET=false
