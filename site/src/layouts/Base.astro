---
import '@fontsource/mukta/400.css'
import '@fontsource/mukta/600.css'
import '@fontsource/mukta/700.css'
// Titles and headers, English and Nepali alike (one family for both scripts). Weight axis only: the
// width axis triples the download. The Devanagari file loads only where Nepali text is shown.
import '@fontsource-variable/anek-devanagari/wght.css'
import '../styles/global.css'
import { appUrl, contact, meta } from '../content'

const canonical = new URL(Astro.url.pathname, Astro.site).href
const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'SoftwareApplication',
  name: 'NirmanKhata',
  alternateName: 'निर्माण खाता',
  url: 'https://nirman-khata.com/',
  applicationCategory: 'BusinessApplication',
  operatingSystem: 'Android, Web',
  description: meta.ogDescription,
  areaServed: { '@type': 'Country', name: 'Nepal' },
  publisher: {
    '@type': 'Organization',
    name: 'NirmanKhata',
    url: 'https://nirman-khata.com/',
    email: contact.email,
    telephone: contact.callNumber.replace(' ', '-'),
  },
}
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon-180x180.png" />
    <meta name="theme-color" content="#faf7f1" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="NirmanKhata" />
    <meta property="og:title" content={meta.ogTitle} />
    <meta property="og:description" content={meta.ogDescription} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content="https://nirman-khata.com/og.png" />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta name="twitter:card" content="summary_large_image" />
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body class="font-sans antialiased">
    <a href="#main" class="sr-only focus:not-sr-only focus:absolute focus:left-4 focus:top-4 focus:rounded focus:bg-white focus:px-3 focus:py-2">Skip to content</a>
    <header class="border-b border-line/70 bg-paper/95">
      <div class="mx-auto flex max-w-6xl items-center justify-between gap-4 px-4 py-3 sm:px-6">
        <a href="/" class="flex items-center gap-2.5" aria-label="NirmanKhata home">
          <svg viewBox="0 0 64 64" width="36" height="36" aria-hidden="true">
            <rect width="64" height="64" rx="14" fill="#6a1f24" />
            <path d="M14 46V22l18-10 18 10v24M24 46V32h16v14" fill="none" stroke="#fff" stroke-width="5" stroke-linejoin="round" />
          </svg>
          <span class="font-display text-2xl font-semibold tracking-tight">NirmanKhata</span>
        </a>
        <nav class="flex items-center gap-1 text-[15px] font-semibold sm:gap-4">
          <a href="#how" class="hidden min-h-11 items-center px-2 text-subtle hover:text-ink sm:flex">How it works</a>
          <a href="#contact" class="hidden min-h-11 items-center px-2 text-subtle hover:text-ink sm:flex">Contact</a>
          <a href={appUrl('/login')} class="flex min-h-11 items-center rounded-lg border border-ink/80 px-4 hover:bg-white">Sign in</a>
        </nav>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="bg-bahi text-white/85">
      <div class="mx-auto flex max-w-6xl flex-col gap-6 px-4 py-10 sm:flex-row sm:items-end sm:justify-between sm:px-6">
        <div>
          <div class="font-display text-2xl font-semibold text-white">NirmanKhata</div>
          <div class="text-sm">Construction site and cost register for Nepal</div>
          <div lang="ne" class="font-display mt-1 text-base text-white/70">निर्माण खाता</div>
        </div>
        <ul class="flex flex-col gap-1 text-sm sm:items-end">
          <li><a class="hover:text-white hover:underline" href={contact.whatsAppLink} target="_blank" rel="noreferrer">WhatsApp {contact.whatsAppNumber}</a></li>
          <li><a class="hover:text-white hover:underline" href={contact.callLink}>Call {contact.callNumber}</a></li>
          <li><a class="hover:text-white hover:underline" href={contact.emailLink}>{contact.email}</a></li>
        </ul>
      </div>
    </footer>
  </body>
</html>
